<?xml version="1.0" encoding="utf-8"?>
<!-- Step 84: the icon is now two layers. The background is the same picture blurred (fills the whole
     shape with no hard dark edge); the foreground is the sharp picture inset into the 66dp safe zone
     with a feathered rounded edge, so launchers' circle / squircle masks no longer cut its panel. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg_art" />
    <foreground android:drawable="@drawable/ic_launcher_fg_art" />
    <monochrome android:drawable="@drawable/ic_launcher_mono" />
</adaptive-icon>
